* text=auto
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
packwiz/** text=auto eol=lf
compat/control-bridge/** text=auto eol=lf
# Unified diff context markers on otherwise empty lines are significant bytes.
compat/proposals/**/*.patch whitespace=-blank-at-eol
